{
  "name": "apexoria-content-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run check:client-bundle",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts eslint-rules next.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/server/db/database.types.ts",
    "check:client-bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@serwist/next": "9.5.13",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "fast-xml-parser": "5.11.2",
    "motion": "14.9.0",
    "next": "15.5.28",
    "portkey-ai": "3.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "3.9.10",
    "serwist": "9.5.13",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "glob": "14.0.2",
    "postcss": "8.5.32",
    "zod": "4.6.7"
  }
}
