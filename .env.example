# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=
PORTKEY_API_KEY=
CRON_SECRET=

# Server-side configuration
# Owner-authorized HTTPS Portkey gateway endpoint, ending in /v1
PORTKEY_BASE_URL=
# Gateway model alias; no virtual key or config ID is required
AI_MODEL=
# Enable only after Group B validation and reviewed hosted migrations 0012/0013
# (admins can override this at runtime from /admin/settings)
AI_GENERATION_ENABLED=false
# Comma-separated owner emails: always admins, never lockable from the panel
ADMIN_EMAILS=
# Legacy allowlist: still admits listed emails until imported in /admin/users.
# Access now fails closed — an empty list no longer admits every account.
ALLOWED_EMAILS=
# Defaults below can be overridden at runtime from the admin panel
NEWS_FEED_URLS=
# Owner-approved default: 30 days, measured from fetched_at
NEWS_RETENTION_DAYS=
PLAN_DAY_OF_MONTH=
REGEN_DAILY_LIMIT=
GLOBAL_DAILY_AI_LIMIT=
PLANNING_HORIZON_MONTHS=

# Canonical application origin
NEXT_PUBLIC_APP_URL=
